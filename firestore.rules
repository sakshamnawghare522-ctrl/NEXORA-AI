rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection document for initial boot health check
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User Public Profile
    match /users/{userId}/public/profile {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // User Monitored Competitors Subcollection
    match /users/{userId}/competitors/{competitorId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(competitorId);
      allow delete: if isOwner(userId);
    }

    // User Radar Alerts Subcollection
    match /users/{userId}/radarAlerts/{alertId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(alertId);
      allow delete: if isOwner(userId);
    }
  }
}
